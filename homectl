#!/usr/bin/env bash
# homectl: drive Foyer (Sean's Fire TV home screen) over adb.
#
#   ./homectl [-t bedroom|living|all|<ip[:port]>] <command> [args]
#
# The TV defaults to $FOYER_TV, else bedroom (the test stick); -t all runs the command on every TV
# in TVS below. Run `./homectl help` for commands. Works from Git Bash on Windows and from Linux.
# adb is found via $ADB, PATH, ~/platform-tools, or the platform-tools folder next to this repo's
# parent ("Firestick Work/platform-tools"). FOYER_PKG=com.sean.foyer.dev drives the dev build.
#
# Everything app-side goes through one broadcast receiver that only adb can reach
# (app/src/main/java/dev/rohan/foyer/Control.kt). The rest is plain adb: install, photos, health.
set -euo pipefail
export MSYS_NO_PATHCONV=1   # Git Bash would otherwise rewrite /sdcard/... into a Windows path

PKG="${FOYER_PKG:-com.sean.foyer}"
RECEIVER=$PKG/dev.rohan.foyer.ControlReceiver
ACTIVITY=$PKG/dev.rohan.foyer.MainActivity
HOF=io.github.toolicious.homeonfire
HOF_SERVICE=$HOF/$HOF.HijackService
PHOTO_DIR=/sdcard/Pictures/Foyer
ART_DIR=$PHOTO_DIR/art   # tile art: <package>.jpg|png|webp (homectl art)
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Packages that should stay disabled: the one list, shared with FireStick-Tune.ps1.
DEBLOAT_LIST="$HERE/debloat.txt"

TVS=(bedroom living)      # what -t all means

tv_addr() {
  case "$1" in
    bedroom) echo 192.168.1.228:5555 ;;   # Fire TV Stick 4K (2nd gen), AFTKM: the test stick
    living)  echo 192.168.1.235:5555 ;;   # Fire TV Stick 4K Max (2nd gen), AFTKRT
    *:*)     echo "$1" ;;
    *)       echo "$1:5555" ;;
  esac
}

TV="${FOYER_TV:-bedroom}"
if [[ "${1:-}" == "-t" ]]; then
  [[ $# -ge 2 ]] || { echo "homectl: -t needs a TV: bedroom, living, all, or an address" >&2; exit 2; }
  TV="$2"; shift 2
fi

# -t all: the same command on each TV in turn; the exit status is non-zero if any of them failed.
if [[ "$TV" == all ]]; then
  case "${1:-help}" in
    help|-h|--help) ;;
    *)
      rc=0
      for t in "${TVS[@]}"; do
        printf '== %s\n' "$t"
        "$0" -t "$t" "$@" || rc=$?
      done
      exit "$rc" ;;
  esac
else
  SERIAL="$(tv_addr "$TV")"
fi

find_adb() {
  if [[ -n "${ADB:-}" ]]; then echo "$ADB"; return; fi
  if command -v adb >/dev/null 2>&1; then command -v adb; return; fi
  for c in "$HOME/platform-tools/adb" "$HERE/../../platform-tools/adb.exe" "$HERE/../../platform-tools/adb"; do
    [[ -x "$c" ]] && { echo "$c"; return; }
  done
  echo "homectl: no adb found (set ADB=/path/to/adb)" >&2; exit 2
}
ADB_BIN="$(find_adb)"

adb()  { "$ADB_BIN" -s "$SERIAL" "$@"; }
# A local file path adb.exe can open (Git Bash's /c/... means nothing to a Windows exe).
local_path() { if command -v cygpath >/dev/null 2>&1; then cygpath -w "$1"; else echo "$1"; fi; }
sh_()  { adb shell "$@" | tr -d '\r'; }
# Quote one argument for the TV's shell.
q()    { local s=${1//\'/\'\\\'\'}; printf "'%s'" "$s"; }

connect() {
  "$ADB_BIN" connect "$SERIAL" >/dev/null 2>&1 || true
  local state; state="$("$ADB_BIN" -s "$SERIAL" get-state 2>/dev/null | tr -d '\r' || true)"
  if [[ "$state" != device ]]; then
    echo "homectl: $SERIAL is '${state:-unreachable}'. ADB debugging on? 'Allow' prompt on the TV?" >&2
    exit 2
  fi
}

# ctl <cmd> [extras...]: one broadcast to Foyer; prints its answer, exits 1 if Foyer said error.
ctl() {
  local cmd="$1"; shift
  local raw
  raw="$(adb shell am broadcast -n "$RECEIVER" --es cmd "$(q "$cmd")" "$@" | tr -d '\r')"
  if [[ "$raw" != *"data=\""* ]]; then
    if [[ "$raw" == *"result=0"* ]]; then echo "ok"; return; fi
    echo "homectl: no answer from Foyer. Installed? ($PKG)" >&2
    echo "$raw" >&2; exit 1
  fi
  local data="${raw#*data=\"}"; data="${data%\"*}"
  echo "$data"
  [[ "$raw" == *"result=0,"* ]]
}

# Arguments as named extras: arg, arg2.
ctl_args() {
  local cmd="$1"; shift
  local extras=()
  [[ $# -ge 1 ]] && extras+=(--es arg "$(q "$1")")
  [[ $# -ge 2 ]] && { shift; extras+=(--es arg2 "$(q "$*")"); }
  ctl "$cmd" "${extras[@]}"
}

b64() { base64 -w0 2>/dev/null < "$1" || base64 < "$1" | tr -d '\n'; }

# Python for scripts/framestats.py: python3 on Linux, often just python (or nothing) in Git Bash.
PY="$(command -v python3 || command -v python || true)"

# Foyer's answer to `get`, whole: matched in memory, never piped into an early-exiting grep.
on_screen() { local s; s="$(ctl get 2>/dev/null)" || return 1; [[ "$s" == *'"onScreen": true'* ]]; }

usage() {
  cat <<EOF
homectl [-t bedroom|living|all|<ip>] <command>   TV now: $TV (${SERIAL:-${TVS[*]}})

Settings (source of truth: config.json next to this script)
  apply [file]              send config.json (or file) to the TV; a bad value changes nothing
  diff [file]               what apply would change ("in sync", else one line each; exit 1)
  pull [file]               save the TV's live settings into config.json (or file)
  get                       everything as JSON: settings, home row, apps, photos, screen
  config                    the TV's settings, config.json-shaped
  set <key> <value>         seconds on|off · date on|off · night Auto|Always|Off
                            night_from 0-23 · night_to 0-23 · rotation Never|FiveMinutes|Hourly|Daily

Home row and apps (<app> = package or any unambiguous bit of its name)
  apps                      installed apps: package, label
  add <app> [pos]           onto the home row (end, or 1-based position)
  remove <app>              off the home row
  move <app> <pos>          along the home row
  hide <app> | unhide <app> out of All apps entirely / back
  label <app> [name]        rename a tile; no name resets it
  art <app> [image]         tile art from a .jpg/.png/.webp of any size (Foyer covers and crops);
                            no image goes back to the app's own banner
  which <app>               the package <app> resolves to
  launch <app>              open it

Photos (/sdcard/Pictures/Foyer; the file name is the caption)
  wall <image>...           push photos (Foyer crops to 16:9 itself)
  unwall <file name>        delete one from the TV
  photo next|<name>         show one now

Screen and setup
  open                      bring Foyer to the front (never 'am start -S': it kills Home on Fire's hook)
  ui home|apps|customize|settings
  key <key>...              remote keys: up down left right ok back home menu play rew ff sleep wake
                            (or any KEYCODE_*); they reach whatever is on screen
  rescan                    re-read apps, photos, settings
  shot [name]               screenshot into launcher/_scratch
  dump                      uiautomator dump, as text (cheaper than a screenshot)
  install [apk]             install/update Foyer and grant its permissions
  hof                       open Home on Fire's own screen
  hof-target [package]      set Home on Fire's target (default: Foyer), pressing OK only on the target chip
  select "<text>"           in a TV list (e.g. Home on Fire's target picker), step down to the
                            row containing <text> and press OK on it
  health [--home]           check everything that should be true, config.json included; non-zero
                            exit on drift. --home also presses Home to prove it lands on Foyer
                            (interrupts playback)
  perf [seconds] [--walk]   frame times (against the TV's own refresh rate) and memory while you use
                            the remote for <seconds> (10); --walk drives the home row and the
                            drawer itself, arrows and Back only
  logs [lines]              Foyer's recent log lines, and its last crash if there is one
  reset                     forget all settings on the TV (first-run defaults)
  raw <cmd> [arg] [arg2]    any Control.kt command as-is

FOYER_TV picks the default TV; FOYER_PKG=com.sean.foyer.dev drives the dev build.
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage; exit 0 ;;
esac
connect

case "$cmd" in
  get|config|apps|rescan|reset) ctl "$cmd" ;;
  set|add|remove|move|hide|unhide|label|launch|photo|ui|which) ctl_args "$cmd" "$@" ;;
  raw) c="$1"; shift; ctl_args "$c" "$@" ;;

  apply)
    f="${1:-$HERE/config.json}"
    [[ -f "$f" ]] || { echo "homectl: no $f" >&2; exit 2; }
    ctl apply --es b64 "$(b64 "$f")"
    ;;
  diff)
    f="${1:-$HERE/config.json}"
    [[ -f "$f" ]] || { echo "homectl: no $f" >&2; exit 2; }
    out="$(ctl diff --es b64 "$(b64 "$f")")" || { echo "$out" >&2; exit 2; }
    echo "$out"
    [[ "$out" == "in sync" ]]
    ;;
  pull)
    f="${1:-$HERE/config.json}"
    out="$(ctl config)" || { echo "$out" >&2; exit 1; }
    printf '%s\n' "$out" > "$f"
    echo "wrote $f"
    ;;

  art)
    [[ $# -ge 1 ]] || { echo "usage: homectl art <app> [image]" >&2; exit 2; }
    p="$(ctl_args which "$1")" || { echo "$p" >&2; exit 1; }
    [[ "$p" =~ ^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z0-9_]+)+$ ]] || { echo "homectl: '$p' isn't a package" >&2; exit 1; }
    if [[ $# -ge 2 ]]; then
      img="$2"; ext="${img##*.}"; ext="${ext,,}"
      [[ -f "$img" ]] || { echo "homectl: no $img" >&2; exit 2; }
      case "$ext" in jpg|jpeg|png|webp) ;; *) echo "homectl: tile art must be .jpg, .png or .webp" >&2; exit 2 ;; esac
    fi
    # One art file per app: clear every extension first. ${..:?} stops here if either is ever empty.
    old=""; for e in jpg jpeg png webp; do old+=" ${ART_DIR:?}/${p:?}.$e"; done
    sh_ "mkdir -p ${ART_DIR:?} && rm -f$old"
    if [[ $# -ge 2 ]]; then
      adb push "$(local_path "$img")" "$ART_DIR/$p.$ext" >/dev/null
      echo "$p: tile art from $(basename "$img")"
    else
      echo "$p: back to its own banner"
    fi
    ctl_args art "$p" >/dev/null || echo "(couldn't tell Foyer; it picks the art up when it next starts)"
    ;;

  wall)
    [[ $# -ge 1 ]] || { echo "usage: homectl wall <image>..." >&2; exit 2; }
    sh_ "mkdir -p $PHOTO_DIR" >/dev/null
    for img in "$@"; do adb push "$(local_path "$img")" "$PHOTO_DIR/" >/dev/null && echo "pushed $(basename "$img")"; done
    ctl rescan >/dev/null 2>&1 || echo "(Foyer isn't running; it picks them up when it opens)"
    ;;
  unwall)
    [[ $# -ge 1 ]] || { echo "usage: homectl unwall <file name>" >&2; exit 2; }
    sh_ "rm $(q "$PHOTO_DIR/$1")"
    ctl rescan >/dev/null 2>&1 || true
    echo "removed $1"
    ;;

  open) sh_ "am start -n $ACTIVITY" ;;
  key)
    [[ $# -ge 1 ]] || { echo "usage: homectl key <key>... (homectl help lists them)" >&2; exit 2; }
    codes=()
    for k in "$@"; do
      case "${k,,}" in
        up|down|left|right)      codes+=("KEYCODE_DPAD_${k^^}") ;;
        ok|center|select|enter)  codes+=(KEYCODE_DPAD_CENTER) ;;
        back)                    codes+=(KEYCODE_BACK) ;;
        home)                    codes+=(KEYCODE_HOME) ;;
        menu)                    codes+=(KEYCODE_MENU) ;;
        play|pause|playpause)    codes+=(KEYCODE_MEDIA_PLAY_PAUSE) ;;
        rew|rewind)              codes+=(KEYCODE_MEDIA_REWIND) ;;
        ff|fastforward|forward)  codes+=(KEYCODE_MEDIA_FAST_FORWARD) ;;
        sleep)                   codes+=(KEYCODE_SLEEP) ;;
        wake|wakeup)             codes+=(KEYCODE_WAKEUP) ;;
        *)
          [[ "${k^^}" =~ ^KEYCODE_[A-Z0-9_]+$ ]] || { echo "homectl: unknown key '$k'" >&2; exit 2; }
          codes+=("${k^^}") ;;
      esac
    done
    # One adb round trip; each `input` call takes a few hundred ms, which paces the presses.
    sh_ "for k in ${codes[*]}; do input keyevent \$k; done"
    ;;

  hof)  sh_ "am start -n $HOF/.MainActivity" ;;
  shot)
    mkdir -p "$HERE/../_scratch"
    f="$HERE/../_scratch/${1:-shot-$TV-$(date +%H%M%S)}.png"
    adb exec-out screencap -p > "$f" && echo "$f"
    ;;
  dump)
    sh_ "uiautomator dump /sdcard/ui.xml" >/dev/null
    sh_ "cat /sdcard/ui.xml" | tr '>' '\n' \
      | grep -o 'resource-id="[^"]*"\|text="[^"]\+"\|content-desc="[^"]\+"\|focused="true"' | paste -sd' ' | sed 's/resource-id=/\n/g'
    echo
    ;;

  install)
    apk="${1:-}"
    if [[ -z "$apk" ]]; then
      base="${LOCALAPPDATA:+$(cygpath -u "$LOCALAPPDATA" 2>/dev/null || echo "$LOCALAPPDATA")/foyer-build/app}"
      variant=release; [[ "$PKG" == *.dev ]] && variant=dev
      # shellcheck disable=SC2012 # newest first; build output names have no surprises
      apk="$(ls -t "${base:-$HERE/app/build}"/outputs/apk/$variant/*.apk 2>/dev/null | head -1 || true)"
    fi
    [[ -f "$apk" ]] || { echo "homectl: no APK (build with ./gradlew assembleRelease, or pass a path)" >&2; exit 2; }
    echo "installing $apk"
    adb install -r "$(local_path "$apk")"
    sh_ "pm grant $PKG android.permission.READ_EXTERNAL_STORAGE" || true
    sh_ "appops set $PKG SYSTEM_ALERT_WINDOW allow"
    sh_ "mkdir -p $PHOTO_DIR" >/dev/null
    echo "granted storage + background-start; next: ./homectl -t $TV apply && ./homectl -t $TV health"
    ;;

  health)
    fail=0
    ok()  { printf '  ok    %s\n' "$1"; }
    bad() { printf '  FAIL  %s\n' "$1"; fail=1; }
    echo "$TV ($SERIAL): $(sh_ 'getprop ro.product.model') Fire OS $(sh_ 'getprop ro.build.version.name' | sed 's/^Fire OS //')"

    # Every dumpsys is read whole, then matched. Piped into `grep -q` or `grep -m1`, a check could
    # FAIL (or, inside $(...), end the script) whenever grep stopped reading before dumpsys finished.
    pkginfo="$(sh_ "dumpsys package $PKG" || true)"
    v="$(awk -F= '/^ *versionName=/ { print $2; exit }' <<<"$pkginfo")"
    [[ -n "$v" ]] && ok "Foyer installed ($v)" || bad "Foyer not installed ($PKG)"
    [[ "$pkginfo" == *"READ_EXTERNAL_STORAGE: granted=true"* ]] && ok "photo permission granted" || bad "READ_EXTERNAL_STORAGE not granted (homectl install)"
    [[ "$(sh_ "appops get $PKG SYSTEM_ALERT_WINDOW" || true)" == *allow* ]] && ok "background start allowed (Settings hop, launch)" || bad "SYSTEM_ALERT_WINDOW appop not allowed"

    acc="$(sh_ 'settings get secure enabled_accessibility_services')"
    [[ "$acc" == *"$HOF_SERVICE"* || "$acc" == *"$HOF/.HijackService"* ]] && ok "Home on Fire service enabled" || bad "Home on Fire service not enabled ($acc)"
    [[ "$acc" == *projengmenu* ]] && bad "Projectivy's service is also on: two Home redirectors will fight" || ok "Projectivy redirect off"
    accdump="$(sh_ 'dumpsys accessibility' || true)"
    # "Bound services" and the three lines after it.
    awk '/Bound services/ { n = 4 } n-- > 0 && /homeonfire/ { found = 1 } END { exit !found }' <<<"$accdump" \
      && ok "Home on Fire service bound" || bad "Home on Fire service not bound (open it once: homectl hof)"

    all="$(sh_ 'pm list packages')"; off="$(sh_ 'pm list packages -d')"; n=0; drift=0
    while read -r _ p _; do
      grep -qx "package:$p" <<<"$all" || continue   # not on this firmware
      n=$((n + 1))
      grep -qx "package:$p" <<<"$off" || { bad "$p is enabled again (debloat.txt)"; drift=1; }
    done < <(grep -Ev '^[[:space:]]*(#|$)' "$DEBLOAT_LIST" | tr -d '\r')
    [[ $drift == 0 ]] && ok "debloat: all $n listed packages on this stick disabled"
    [[ "$(sh_ 'settings get global private_dns_specifier')" == dns.adguard-dns.com ]] && ok "Private DNS: AdGuard" || bad "Private DNS changed"
    [[ "$(sh_ 'settings get global window_animation_scale')" == 0.5 ]] && ok "animations 0.5x" || bad "animation scale changed"
    if [[ -f "$HERE/config.json" ]]; then
      d="$(ctl diff --es b64 "$(b64 "$HERE/config.json")" 2>&1 || true)"
      case "$d" in
        "in sync") ok "settings match config.json" ;;
        error:*|homectl:*) bad "couldn't compare settings with config.json (${d%%$'\n'*}); Foyer too old for diff?" ;;
        *) bad "settings differ from config.json: ${d%%$'\n'*} (homectl diff; then apply or pull)" ;;
      esac
    fi

    # Home on Fire keeps its target in private prefs; its log of the last redirect is not readable
    # either. So without --home, health proves the parts it can see without touching the screen.
    if [[ "${1:-}" == --home ]]; then
      sh_ 'input keyevent KEYCODE_HOME'
      sleep 3
      top="$(awk '/mResumedActivity|topResumedActivity/ { print; exit }' <<<"$(sh_ 'dumpsys activity activities' || true)")"
      [[ "$top" == *"$PKG/"* ]] && ok "Home lands on Foyer" || bad "Home landed on: ${top:-?}"
    else
      top="$(awk '/mResumedActivity|topResumedActivity/ { sub(/.* u0 /, ""); sub(/ .*/, ""); print; exit }' <<<"$(sh_ 'dumpsys activity activities' || true)")"
      printf '  --    Home press not tested (add --home; it interrupts playback). On screen: %s\n' "${top:-?}"
    fi
    exit $fail
    ;;

  perf)
    secs=10; walk=0
    for a in "$@"; do
      case "$a" in
        --walk) walk=1 ;;
        ''|*[!0-9]*) echo "usage: homectl perf [seconds] [--walk]" >&2; exit 2 ;;
        *) secs="$a" ;;
      esac
    done
    on_screen || { echo "homectl: Foyer isn't on screen (homectl open, then try again)" >&2; exit 1; }
    # The first line of SurfaceFlinger's latency dump is the refresh period in ns: the frame budget.
    lat="$(sh_ 'dumpsys SurfaceFlinger --latency' || true)"; period="${lat%%$'\n'*}"
    if [[ "$period" =~ ^[0-9]+$ ]] && (( period > 0 )); then
      budget="$(awk -v p="$period" 'BEGIN { printf "%.1f", p / 1e6 }')"
    else
      budget=16.7
    fi
    sh_ "dumpsys gfxinfo $PKG reset" >/dev/null
    if [[ $walk == 1 ]]; then
      ctl_args ui home >/dev/null
      echo "walking the home row and the All apps drawer (arrows and Back only, never OK)"
      # shellcheck disable=SC2016 # $k expands on the TV
      sh_ 'for k in RIGHT RIGHT RIGHT RIGHT LEFT LEFT LEFT LEFT DOWN RIGHT RIGHT RIGHT DOWN UP LEFT; do input keyevent KEYCODE_DPAD_$k; sleep 0.3; done; input keyevent KEYCODE_BACK; sleep 1'
    else
      echo "measuring for ${secs}s: use the remote"
      sleep "$secs"
    fi
    gfx="$(sh_ "dumpsys gfxinfo $PKG framestats")"
    echo "frame budget $budget ms"
    awk '/^(Total frames rendered|Janky frames:|(50|90|95|99)th percentile)/ && n++ < 6 { print "  " $0 }' <<<"$gfx"
    if [[ -n "$PY" ]]; then "$PY" "$HERE/scripts/framestats.py" "$budget" <<<"$gfx"; else echo "(no python: per-stage breakdown skipped)"; fi
    mem="$(sh_ "dumpsys meminfo $PKG" || true)"
    awk '/TOTAL PSS:/ { sub(/^ +/, ""); print "memory  " $0; found = 1; exit }
         /^ +TOTAL / && t == "" { t = $0 }
         END { if (!found && t != "") { sub(/^ +/, "", t); print "memory  " t } }' <<<"$mem"
    ;;

  logs)
    n="${1:-60}"
    [[ "$n" =~ ^[0-9]+$ ]] || { echo "usage: homectl logs [lines]" >&2; exit 2; }
    pid="$(sh_ "pidof $PKG" || true)"; pid="${pid%% *}"
    if [[ -n "$pid" ]]; then
      echo "== Foyer (pid $pid), last $n lines"
      adb logcat -d -v time --pid="$pid" | tr -d '\r' | tail -n "$n"
    else
      echo "== Foyer isn't running"
    fi
    crash="$(adb logcat -d -b crash -v time 2>/dev/null | tr -d '\r' | grep -B1 -A25 "Process: $PKG," || true)"
    if [[ -n "$crash" ]]; then echo "== last crash"; tail -n 40 <<<"$crash"; fi
    ;;

  select)
    # Lists mark the highlighted row selected="true" (focused="true" is the ListView itself).
    want="${1:?usage: homectl select \"<text>\"}"
    # The first two texts under the selected node are the row's label and package. One adb call per step.
    step='uiautomator dump /sdcard/ui.xml >/dev/null && cat /sdcard/ui.xml'
    for i in $(seq 0 60); do
      row="$(sh_ "$step" | tr '>' '\n' | awk '
        f && n < 12 { n++; if (match($0, /text="[^"]+"/)) { t = t (t ? "|" : "") substr($0, RSTART + 6, RLENGTH - 7); if (++k == 2) exit } }
        /selected="true"/ { f = 1 }
        END { print t }')"
      [[ -z "$row" && $i == 0 ]] && { echo "homectl: no list with a selected row on screen; open the list first" >&2; exit 1; }
      if [[ "${row,,}" == *"${want,,}"* ]]; then
        echo "selected after $i steps: $row"
        sh_ 'input keyevent KEYCODE_DPAD_CENTER'
        exit 0
      fi
      [[ "$row" == "${last:-}" ]] && { echo "homectl: reached the end of the list at '$row' without '$want'" >&2; exit 1; }
      last="$row"
      step='input keyevent KEYCODE_DPAD_DOWN && uiautomator dump /sdcard/ui.xml >/dev/null && cat /sdcard/ui.xml'
    done
    echo "homectl: '$want' not found in 60 steps (last: $row)" >&2; exit 1
    ;;

  hof-target)
    # Home on Fire's screen opens with focus on whichever row was last used, and OK on a toggle row
    # flips it (that once switched its accessibility service off). So read the focused row each step
    # and press OK only on the target chip, the top row: "Choose target app…" or "<App> (<package>)".
    want="${1:-$PKG}"
    sh_ "am start -n $HOF/.MainActivity" >/dev/null; sleep 2
    for i in $(seq 0 10); do
      focus="$(sh_ 'uiautomator dump /sdcard/ui.xml >/dev/null && cat /sdcard/ui.xml' | tr '>' '\n' | awk '
        /focused="true"/ { f = 1 }
        f && match($0, /text="[^"]+"/) { t = substr($0, RSTART + 6, RLENGTH - 7); if (t !~ /^&#/) { print t; exit } }')"
      [[ "$focus" == "Choose target app"* || "$focus" =~ \(.+\)$ ]] && break
      focus=""
      sh_ 'input keyevent KEYCODE_DPAD_UP'
    done
    [[ -n "$focus" ]] || { echo "homectl: couldn't reach Home on Fire's target chip; nothing pressed" >&2; exit 1; }
    echo "target now: $focus"
    sh_ 'input keyevent KEYCODE_DPAD_CENTER'; sleep 2
    "$0" -t "$TV" select "$want"
    ;;

  *) echo "homectl: unknown command '$cmd'" >&2; usage >&2; exit 2 ;;
esac
